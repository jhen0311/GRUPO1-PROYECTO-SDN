# Servidor externo: atiende a M1 (NAS) y transporta el túnel EAP-TTLS.
server campus {
	listen {
		type = auth
		ipaddr = *
		port = 1812
	}

	authorize {
		filter_username
		eap {
			ok = return
		}
		reject
	}

	authenticate {
		eap
	}

	post-auth {
		# Copia al Access-Accept lo que resolvió el túnel interno (AVZ07, Tabla 7).
		update reply {
			&User-Name := &session-state:User-Name
			&Filter-Id := &session-state:Filter-Id
			&Session-Timeout := &session-state:Session-Timeout
			&PUCP-Role-Code := &session-state:PUCP-Role-Code
			&PUCP-Max-Sessions := &session-state:PUCP-Max-Sessions
		}
		Post-Auth-Type REJECT {
			attr_filter.access_reject
			eap
			remove_reply_message_if_eap
		}
	}
}
