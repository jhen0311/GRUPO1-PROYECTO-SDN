# /etc/tel354/m6.env · configuración de M6 (auditoría) en el host de VM-CLUSTER
# instalar_m6.sh la copia la primera vez; luego se edita aquí.

# PostgreSQL (VM-IDENTIDAD), rol onos_m6: solo INSERT en auth_log (+ 06_m6.sql opcional)
PG_HOST=10.200.3.12
PG_DB=campus
PG_USUARIO=onos_m6
PG_CLAVE=m6-demo
PG_SSLMODE=verify-ca
PG_CA=/etc/tel354/certs/ca.pem

# Fuentes: contenedores de ONOS (docker logs) y REST de M5 (red interna Docker, comun/config/slice.env)
CONTENEDORES=onos-1 onos-2 onos-3
ONOS_REST=http://192.168.200.11:8181 http://192.168.200.12:8181 http://192.168.200.13:8181
ONOS_AUTH=onos:rocks

# Escritura por lotes (LLSD R3, sección 5.7): cada 1 s o 100 filas; hasta 10 000 en memoria
LOTE=100
PERIODO_S=1
MAXIMO=10000

# Punto de control (último instante guardado de cada instancia) y desde cuándo leer la primera vez
ESTADO=/var/lib/tel354/m6-estado.json
DESDE=1m
