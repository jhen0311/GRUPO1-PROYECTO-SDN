<?xml version="1.0" encoding="UTF-8"?>
<!--
  M4a - Ventanas deslizantes (R3) · TEL354 Grupo 01 · plantilla de partida para ONOS 2.7.0 (Java 11).
  Requiere tel354-api instalado (comun/tel354-api). Compilar: mvn clean install
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.onosproject</groupId>
        <artifactId>onos-dependencies</artifactId>
        <version>2.7.0</version>
    </parent>
    <groupId>pe.edu.pucp.tel354</groupId>
    <artifactId>tel354-m4a</artifactId>
    <version>2.0.0</version>
    <packaging>bundle</packaging>
    <description>R3: métricas P, D, N y F en W1 y W2; ThreatSuspected</description>
    <properties>
        <!-- La guía de estilo de ONOS (checkstyle) no aplica a las apps del grupo -->
        <checkstyle.skip>true</checkstyle.skip>
        <onos.app.name>tel354.m4a</onos.app.name>
        <onos.app.title>TEL354 M4a - Ventanas deslizantes</onos.app.title>
        <onos.app.origin>PUCP TEL354 Grupo 01</onos.app.origin>
        <onos.app.category>Security</onos.app.category>
        <onos.app.url>https://www.pucp.edu.pe</onos.app.url>
        <onos.app.readme>R3: métricas P, D, N y F en W1 y W2; ThreatSuspected</onos.app.readme>
        <onos.app.requires>tel354.api,tel354.m1,tel354.m2</onos.app.requires>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.onosproject</groupId>
            <artifactId>onos-api</artifactId>
            <version>${onos.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.onosproject</groupId>
            <artifactId>onlab-misc</artifactId>
            <version>${onos.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component.annotations</artifactId>
            <version>1.4.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>pe.edu.pucp.tel354</groupId>
            <artifactId>tel354-api</artifactId>
            <version>2.0.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <instructions>
                        <Export-Package/>
                        <Private-Package>pe.edu.pucp.tel354.m4a.*</Private-Package>
                    </instructions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.onosproject</groupId>
                <artifactId>onos-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
