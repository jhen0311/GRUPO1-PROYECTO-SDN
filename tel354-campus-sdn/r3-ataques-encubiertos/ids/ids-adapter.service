[Unit]
Description=Adaptador Suricata -> M4a (TEL354 R3)
After=suricata.service network-online.target

[Service]
# Slice: valores por defecto. Piloto: descomentar y ajustar
#Environment=ONOS_URLS=http://172.16.0.13:8181/onos/campus/v1/ids/alertas,http://172.16.0.11:8181/onos/campus/v1/ids/alertas
#Environment=SENSORES=eth0=core2,eth1=core1
ExecStart=/usr/bin/python3 /opt/tel354/ids_adapter.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
