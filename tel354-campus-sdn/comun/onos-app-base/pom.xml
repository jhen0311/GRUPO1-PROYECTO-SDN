<?xml version="1.0" encoding="UTF-8"?>
<!--
  tel354.base - M7 (régimen base) + M8 (caminos fijos) · TEL354 Grupo 01
  App OSGi para ONOS 2.7.0 (Java 11). Instala el régimen base de cada switch al detectarlo
  (DeviceListener y LinkListener); el rol del switch sale de la tabla switch_acceso.
  Requiere tel354-api instalado. Se instala antes que M1.
  Compilar:   mvn clean install
  Instalar:   bash comun/onos-app-base/instalar_base.sh
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.onosproject</groupId>
        <artifactId>onos-dependencies</artifactId>
        <version>2.7.0</version>
    </parent>

    <groupId>pe.edu.pucp.tel354</groupId>
    <artifactId>tel354-base</artifactId>
    <version>2.0.0</version>
    <packaging>bundle</packaging>

    <description>M7 + M8: régimen base y caminos fijos instalados al detectar cada switch</description>
    <url>https://www.pucp.edu.pe</url>

    <properties>
        <!-- La guía de estilo de ONOS (checkstyle) no aplica a las apps del grupo -->
        <checkstyle.skip>true</checkstyle.skip>
        <onos.app.name>tel354.base</onos.app.name>
        <onos.app.title>TEL354 M7+M8 - Régimen base y caminos fijos</onos.app.title>
        <onos.app.origin>PUCP TEL354 Grupo 01</onos.app.origin>
        <onos.app.category>Traffic Engineering</onos.app.category>
        <onos.app.url>https://www.pucp.edu.pe</onos.app.url>
        <onos.app.readme>M7: Tabla 0 (900, 800 con meter ctl_P, 600, 10). M8: Tabla 2 fija (200, 180) y
            core (210, 205, 200, 0). Conciliación idempotente al conectarse cada switch.</onos.app.readme>
        <onos.app.requires>org.onosproject.openflow,tel354.api</onos.app.requires>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.onosproject</groupId>
            <artifactId>onos-api</artifactId>
            <version>${onos.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.onosproject</groupId>
            <artifactId>onlab-osgi</artifactId>
            <version>${onos.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.onosproject</groupId>
            <artifactId>onlab-misc</artifactId>
            <version>${onos.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.onosproject</groupId>
            <artifactId>onos-cli</artifactId>
            <version>${onos.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component.annotations</artifactId>
            <version>1.4.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.karaf.shell</groupId>
            <artifactId>org.apache.karaf.shell.core</artifactId>
            <version>4.2.14</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.9.10</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>pe.edu.pucp.tel354</groupId>
            <artifactId>tel354-api</artifactId>
            <version>2.0.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- Driver JDBC embebido en el bundle (Java 11) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>${project.groupId}.${project.artifactId}</Bundle-SymbolicName>
                        <Export-Package/>
                        <Private-Package>pe.edu.pucp.tel354.base.*</Private-Package>
                        <Karaf-Commands>pe.edu.pucp.tel354.base.cli</Karaf-Commands>
                        <Embed-Dependency>postgresql;scope=compile|runtime;inline=false</Embed-Dependency>
                        <Embed-Transitive>false</Embed-Transitive>
                        <Import-Package>!org.checkerframework.*,com.sun.jna*;resolution:=optional,waffle*;resolution:=optional,org.osgi.service.jdbc*;resolution:=optional,javax.naming*;resolution:=optional,*</Import-Package>
                    </instructions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.onosproject</groupId>
                <artifactId>onos-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
