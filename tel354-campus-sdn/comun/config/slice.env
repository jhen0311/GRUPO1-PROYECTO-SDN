# =====================================================================
# Parámetros del piloto en el slice (LAB6: Tablas 1 a 3). Un solo
# archivo para los scripts de comun/, r1-identidad/ y r3-ataques-encubiertos/.
# Valores de prueba: cámbialos fuera del laboratorio.
# (La maqueta de Mininet sigue en demo.env.)
# =====================================================================
# --- Clúster de control (VM Controlador) ---------------------------------
IP_CLUSTER_HOST=172.16.0.10            # eth0 del host Docker (in-band, hacia SW-C1)
NODOS="onos-1 onos-2 onos-3"
IP_ONOS_1=172.16.0.11                  # in-band por eth0 (SW-C1)
IP_ONOS_2=172.16.0.12                  # in-band por eth0 (SW-C1)
IP_ONOS_3=172.16.0.13                  # in-band por eth1 (SW-C2)
MAC_ONOS_1=02:16:00:00:00:11           # MAC fija de las interfaces macvlan
MAC_ONOS_2=02:16:00:00:00:12
MAC_ONOS_3=02:16:00:00:00:13
RED_DOCKER=192.168.200.0/24            # red interna de Docker (Atomix y clúster ONOS; no sale al slice)
DOCKER_ONOS_1=192.168.200.11
DOCKER_ONOS_2=192.168.200.12
DOCKER_ONOS_3=192.168.200.13
DOCKER_ATOMIX_1=192.168.200.21
DOCKER_ATOMIX_2=192.168.200.22
DOCKER_ATOMIX_3=192.168.200.23
IMG_ONOS=onosproject/onos:2.7.0
IMG_ATOMIX=atomix/atomix:3.1.9
ONOS_URL=http://192.168.200.11:8181/onos/v1   # REST desde el host Docker
ONOS_AUTH=onos:rocks

# --- Switches OVS (puente br0; IP de la interfaz LOCAL) -----------------
IP_SW_C1=172.16.0.21
IP_SW_C2=172.16.0.22
IP_SW_A1=172.16.0.23
IP_SW_A2=172.16.0.24
DPID_SW_C1=00000000000000c1
DPID_SW_C2=00000000000000c2
DPID_SW_A1=0000000000000001
DPID_SW_A2=0000000000000002
MAC_GW=02:00:00:00:00:c8               # gateway virtual de servidores y del plano de control

# --- Servidores (puertos trusted del SW-C2) -----------------------------
IP_GESTION=10.200.0.5                  # S-SERVICIOS: servidor de gestión TI (SSH)
IP_KEA=10.200.0.13                     # S-SERVICIOS: Kea DHCP 2.4 + Control Agent (8000)
IP_DNS=10.200.0.14                     # S-SERVICIOS: DNS
IP_IDS=10.200.0.20                     # IDS-Suricata: eth2 (alertas)
IP_RADIUS=10.200.3.10                  # S-IDENTIDAD: FreeRADIUS 3.2
IP_LDAP=10.200.3.11                    # S-IDENTIDAD: OpenLDAP (LDAPS 636)
IP_PG=10.200.3.12                      # S-IDENTIDAD: PostgreSQL 16
IP_CAMPUS_VIRTUAL=10.200.1.10          # S-RECURSOS
IP_BIBLIOTECA=10.200.1.20
IP_BD_ACADEMICA=10.200.1.30
IP_BD_ADMINISTRATIVA=10.200.1.40
IP_LAB_TEL354=10.200.2.10              # S-CURSOS
IP_NUBE_TEL141=10.200.2.20
IP_CURSO3=10.200.2.30

# --- Secretos de prueba ---------------------------------------------------
LDAP_ADMIN_PW=admin-demo
LDAP_RADIUS_PW=radius-ldap-demo
RADIUS_SECRET=tel354-secreto           # M1 (172.16.0.11-13) <-> FreeRADIUS
PG_DB=campus
KEA_DB=kea
KEA_DB_USER=kea
KEA_DB_PW=kea-demo
KEA_HOOKS=/usr/lib/x86_64-linux-gnu/kea/hooks
