# =====================================================================
# Perfil UNA INSTANCIA: un solo ONOS 2.7 (Docker, --network host) con
# control fuera de banda, un switch core y N switches de acceso, y todos
# los servicios (PostgreSQL, OpenLDAP, FreeRADIUS, Kea, DNS y recursos de
# prueba) coubicados en el equipo del controlador, con las mismas IP
# 10.200.x.y del piloto en su interfaz de datos hacia el core.
# Sirve para validar M1 y M5 antes del clúster.
# Uso: TEL354_ENV=una_instancia.env antes de cada script.
# =====================================================================
IP_NAS=10.200.0.2                      # IP de datos de M1 (ens4): NAS-IP de RADIUS y giaddr del relay DHCP.
                                       # En el plano de datos para que Kea pueda responderle (no la red de gestión)
ONOS_URL=http://127.0.0.1:8181/onos/v1
ONOS_AUTH=onos:rocks
IMG_ONOS=onosproject/onos:2.7.0
IF_DATOS=ens4                          # interfaz de datos del controlador (enlace hacia el core)
DPID_CORE=00000000000000c1             # se fijan con comun/topo/ovs_preparar.sh
PUERTO_SERVIDORES=1                    # puerto del core hacia IF_DATOS (tel354.base; 0 = descubrirlo)
DPIDS_ACCESO="0000000000000001 0000000000000002"   # pabellón 1, 2, ... (switch_acceso de la semilla)
MAC_GW=02:00:00:00:00:c8
# Rangos de origen que acepta PostgreSQL: los servicios y ONOS están en el mismo equipo,
# así que conectan con una dirección local (10.200.x.y) o la de la red de control
PG_RED_ONOS="10.200.0.0/16 192.168.0.0/24"
PG_RED_KEA=10.200.0.0/16
PG_RED_RADIUS=10.200.0.0/16
RADIUS_NAS_RED=10.200.0.2/32

# --- Servicios (todos en la interfaz de datos del controlador) ----------
IP_GESTION=10.200.0.5                  # S-SERVICIOS: servidor de gestión TI (SSH)
IP_KEA=10.200.0.13                     # S-SERVICIOS: Kea DHCP 2.4 + Control Agent (8000)
IP_DNS=10.200.0.14                     # S-SERVICIOS: DNS
IP_IDS=10.200.0.20                     # IDS-Suricata: eth2 (alertas)
IP_RADIUS=10.200.3.10                  # S-IDENTIDAD: FreeRADIUS 3.2
IP_LDAP=10.200.3.11                    # S-IDENTIDAD: OpenLDAP (LDAPS 636)
IP_PG=10.200.3.12                      # S-IDENTIDAD: PostgreSQL 16
IP_CAMPUS_VIRTUAL=10.200.1.10          # S-RECURSOS
IP_BIBLIOTECA=10.200.1.20
IP_BD_ACADEMICA=10.200.1.30
IP_BD_ADMINISTRATIVA=10.200.1.40
IP_LAB_TEL354=10.200.2.10              # S-CURSOS
IP_NUBE_TEL141=10.200.2.20
IP_CURSO3=10.200.2.30

# --- Secretos de prueba ---------------------------------------------------
LDAP_ADMIN_PW=admin-demo
LDAP_RADIUS_PW=radius-ldap-demo
RADIUS_SECRET=tel354-secreto           # M1 <-> FreeRADIUS
PG_DB=campus
KEA_DB=kea
KEA_DB_USER=kea
KEA_DB_PW=kea-demo
KEA_HOOKS=/usr/lib/x86_64-linux-gnu/kea/hooks
