# =====================================================================
# Parámetros de la demo TEL354 G01 (Mininet). Un solo archivo para
# todos los scripts. Valores de demo: cámbialos fuera del laboratorio.
# =====================================================================
LDAP_ADMIN_PW=admin-demo
LDAP_RADIUS_PW=radius-ldap-demo
RADIUS_SECRET=tel354-secreto          # secreto compartido M1 (172.16.0.10) <-> FreeRADIUS
PG_DB=campus
KEA_DB=kea
KEA_DB_USER=kea
KEA_DB_PW=kea-demo
ONOS_URL=http://127.0.0.1:8181/onos/v1
ONOS_AUTH=onos:rocks
# Direcciones del diseño (AVZ07, Tabla 2)
IP_ONOS=172.16.0.10
IP_RADIUS=10.200.0.10
IP_LDAP=10.200.0.11
IP_PG=10.200.0.12
IP_KEA=10.200.0.13
IP_DNS=10.200.0.14
IP_GESTION=10.200.0.5
# Ruta de los hooks de Kea (paquetes de ISC en 20.04: comprobar con  ls /usr/lib/x86_64-linux-gnu/kea/hooks)
KEA_HOOKS=/usr/lib/x86_64-linux-gnu/kea/hooks
