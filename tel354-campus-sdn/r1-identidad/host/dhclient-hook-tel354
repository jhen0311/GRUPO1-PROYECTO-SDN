# Hook de dhclient (login.sh lo instala en /etc/dhcp/dhclient-enter-hooks.d/zz-tel354).
# dhclient-script lo carga antes de aplicar cada lease, para cualquier interfaz del equipo.

# Los hosts de Mininet comparten el disco de la VM: si dhclient-script reescribiera
# /etc/resolv.conf desde un host (h1-eth0, h2-eth0, ...), la VM perdería su DNS.
case "$interface" in
  h[0-9]*-eth*)
    make_resolv_conf() { :; }
    ;;
esac

# En las VM con interfaz de gestión (ens3), la ruta por defecto es de gestión: el lease de la
# interfaz de datos no la reemplaza. La intranet (10.0.0.0/8) la agrega login.sh por el gateway
# del rol. Un lease de la propia ens3 no se altera.
if [ "$interface" != "ens3" ] && ip -o link show dev ens3 >/dev/null 2>&1; then
  unset new_routers
fi
