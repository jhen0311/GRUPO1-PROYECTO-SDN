<?xml version="1.0" encoding="UTF-8"?>
<!--
  M1 - Identidad y sesiones (R1) · TEL354 Grupo 01
  App OSGi para ONOS 2.7.0 (Java 11, Karaf 4.2.14, anotaciones OSGi DS), basada en el arquetipo
  onos-bundle-archetype:2.7.0.
  Requiere tel354-api instalado antes (comun/tel354-api).
  Compilar:   mvn clean install
  Instalar:   bash r1-identidad/onos-app-m1/instalar_m1.sh
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.onosproject</groupId>
        <artifactId>onos-dependencies</artifactId>
        <version>2.7.0</version>
    </parent>

    <groupId>pe.edu.pucp.tel354</groupId>
    <artifactId>tel354-m1</artifactId>
    <version>2.0.0</version>
    <packaging>bundle</packaging>

    <description>M1: autenticador 802.1X de paso, sesiones, relay DHCP, proxy ARP del gateway y eventos de R3</description>
    <url>https://www.pucp.edu.pe</url>

    <properties>
        <!-- La guía de estilo de ONOS (checkstyle) no aplica a las apps del grupo -->
        <checkstyle.skip>true</checkstyle.skip>
        <onos.app.name>tel354.m1</onos.app.name>
        <onos.app.title>TEL354 M1 - Identidad y sesiones</onos.app.title>
        <onos.app.origin>PUCP TEL354 Grupo 01</onos.app.origin>
        <onos.app.category>Security</onos.app.category>
        <onos.app.url>https://www.pucp.edu.pe</onos.app.url>
        <onos.app.readme>R1: 802.1X (EAP-TTLS de paso hacia FreeRADIUS), sesiones en PostgreSQL,
            relay DHCP con opción 82 hacia Kea, proxy ARP del gateway virtual y SessionService (R3).</onos.app.readme>
        <onos.app.requires>org.onosproject.openflow,tel354.api</onos.app.requires>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.onosproject</groupId>
            <artifactId>onos-api</artifactId>
            <version>${onos.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.onosproject</groupId>
            <artifactId>onlab-osgi</artifactId>
            <version>${onos.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.onosproject</groupId>
            <artifactId>onlab-misc</artifactId>
            <version>${onos.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.onosproject</groupId>
            <artifactId>onos-cli</artifactId>
            <version>${onos.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component.annotations</artifactId>
            <version>1.4.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.karaf.shell</groupId>
            <artifactId>org.apache.karaf.shell.core</artifactId>
            <version>4.2.14</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>pe.edu.pucp.tel354</groupId>
            <artifactId>tel354-api</artifactId>
            <version>2.0.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- Driver JDBC embebido en el bundle (Java 11) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <instructions>
                        <Export-Package/>
                        <Private-Package>pe.edu.pucp.tel354.m1.*</Private-Package>
                        <Karaf-Commands>pe.edu.pucp.tel354.m1.cli</Karaf-Commands>
                        <Embed-Dependency>postgresql;scope=compile|runtime;inline=false</Embed-Dependency>
                        <Embed-Transitive>false</Embed-Transitive>
                        <!-- El driver referencia paquetes opcionales (JNA, waffle, JNDI, OSGi JDBC)
                             que no se usan aquí: no deben impedir que el bundle se resuelva.
                             Los de ONOS, Karaf, tel354-api y slf4j siguen siendo obligatorios. -->
                        <Import-Package>!org.checkerframework.*,com.sun.jna*;resolution:=optional,waffle*;resolution:=optional,org.osgi.service.jdbc*;resolution:=optional,javax.naming*;resolution:=optional,*</Import-Package>
                    </instructions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.onosproject</groupId>
                <artifactId>onos-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
