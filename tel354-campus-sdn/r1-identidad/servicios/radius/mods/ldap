# Verificación de la contraseña por bind en OpenLDAP sobre LDAPS (D12).
# La cuenta cn=radius solo busca el DN; nunca lee userPassword.
ldap {
	server = 'ldaps://10.200.0.11'
	port = 636
	identity = 'cn=radius,dc=campus,dc=pucp,dc=edu,dc=pe'
	password = ${LDAP_RADIUS_PW}
	base_dn = 'dc=campus,dc=pucp,dc=edu,dc=pe'

	user {
		base_dn = "ou=usuarios,${..base_dn}"
		filter = "(uid=%{%{Stripped-User-Name}:-%{User-Name}})"
		scope = 'sub'
	}

	options {
		chase_referrals = no
		res_timeout = 3
		srv_timelimit = 3
		net_timeout = 2
		idle = 60
		probes = 3
		interval = 3
	}

	tls {
		ca_file = /etc/tel354/certs/ca.pem
		require_cert = 'demand'
	}

	pool {
		start = 2
		min = 2
		max = 8
		spare = 2
		uses = 0
		retry_delay = 5
		lifetime = 0
		idle_timeout = 60
	}
}
